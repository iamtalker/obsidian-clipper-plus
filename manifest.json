{
  "manifest_version": 3,
  "name": "Obsidian Clipper Plus",
  "version": "0.38.0",
  "description": "Web clipper that saves articles, selections, full pages, bookmarks and webtoon images into your Obsidian vault, images included.",
  "permissions": ["activeTab", "scripting", "storage", "debugger"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
